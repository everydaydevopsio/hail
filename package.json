{
  "name": "@everydaydevopsio/hail",
  "version": "0.1.1",
  "description": "Playwright-native testing for real application email workflows",
  "type": "module",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "hail": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./playwright": {
      "types": "./dist/playwright.d.ts",
      "import": "./dist/playwright.js"
    }
  },
  "files": [
    "dist",
    "terraform/examples/cloudflare/main.tf",
    "terraform/examples/cloudflare/.terraform.lock.hcl",
    "terraform/examples/route53/main.tf",
    "terraform/examples/route53/.terraform.lock.hcl",
    "terraform/examples/manual/main.tf",
    "terraform/examples/manual/.terraform.lock.hcl",
    "terraform/modules/receiver/main.tf",
    "terraform/modules/receiver/variables.tf",
    "terraform/modules/receiver/outputs.tf",
    "terraform/modules/receiver/.terraform.lock.hcl",
    "terraform/modules/receiver/lambda/handler.py",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:python": "python3 -m unittest discover -s tests/python -v",
    "test:e2e": "playwright test",
    "test:live": "HAIL_LIVE=1 playwright test",
    "test:package": "node scripts/check-package.mjs",
    "format": "prettier --write src tests '*.json' '*.ts' README.md docs .github/workflows/ci.yml",
    "prepack": "npm run build",
    "test:live:full": "python3 scripts/live-run.py",
    "lint": "eslint src tests scripts *.mjs *.ts",
    "lint:fix": "npm run lint -- --fix",
    "prettier": "prettier --check src tests scripts/*.mjs *.json *.ts *.mjs .github .pre-commit-config.yaml .trivyignore.yaml",
    "prettier:fix": "npm run prettier -- --write",
    "test:coverage": "node --import tsx --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" --test-coverage-lines=50 --test-coverage-functions=50 --test-coverage-branches=50 --test tests/unit/*.test.ts",
    "test:smoke": "npm run build && node --import tsx --test tests/unit/cli.test.ts && npm run test:package",
    "test:prepush": "npm run build && npm run typecheck && npm test && npm run test:smoke"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-ses": "^3.700.0",
    "@aws-sdk/credential-providers": "^3.700.0",
    "@types/node": "22.20.4",
    "cheerio": "^1.0.0",
    "mailparser": "^3.7.0"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.55.0 <2"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-sts": "3.1142.0",
    "@aws-sdk/types": "3.974.6",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@types/mailparser": "^3.4.6",
    "eslint": "^10.12.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/everydaydevopsio/hail"
  }
}
