{
  "name": "@everydaydevopsio/hail",
  "version": "0.1.0",
  "description": "Playwright-native testing for real application email workflows",
  "type": "module",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "hail": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./playwright": {
      "types": "./dist/playwright.d.ts",
      "import": "./dist/playwright.js"
    }
  },
  "files": [
    "dist",
    "terraform",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:python": "python3 -m unittest discover -s tests/python -v",
    "test:e2e": "playwright test",
    "test:live": "HAIL_LIVE=1 playwright test --project=chromium",
    "format": "prettier --write src tests '*.json' '*.ts' README.md docs .github/workflows/ci.yml",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-ses": "^3.700.0",
    "@aws-sdk/credential-providers": "^3.700.0",
    "cheerio": "^1.0.0",
    "mailparser": "^3.7.0"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.55.0 <2"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.0.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
